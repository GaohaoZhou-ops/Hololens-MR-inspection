# Unity caches and generated output (keep Assets, its source .meta files,
# Packages including packages-lock.json, and ProjectSettings in Git).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]in/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
/sysinfo.txt

# Generated IDE projects and per-user settings; keep .vsconfig.
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sln.docstates
*.pidb
*.opendb
*.VC.db

# UWP packages contain the generated client configuration and pairing token.
AppPackages/
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
*.appxsym
*.appxrecipe

# Device photos, pose history, databases, queues and diagnostic logs.
/server/data/
# Also cover receiver data stored outside the default dataDirectory.
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
# Include originals downloaded from the monitor into other project folders.
HL1-[0-9]*-*.jpg
HL1-[0-9]*-*.jpg.meta
.clear-pending/
# Copied headset/editor queues include device identity, photos and spatial data.
CaptureOutbox*/
CaptureOutbox*.meta
editor-outbox*/
editor-outbox*.meta
*.anchor
*.anchor.meta
*.log
*.binlog

# Machine-specific configuration, including custom --config paths.
# Keep *.example.json templates and shared project settings.
*.local.json
*.local.json.meta
/Assets/StreamingAssets/demo-config.json
/Assets/StreamingAssets/demo-config.json.meta
.env
.env.*
!.env.example
!.env.template

# Local signing certificates/keys and Unity license files (including Unity meta).
*.pfx
*.pfx.meta
*.p12
*.p12.meta
*.pem
*.pem.meta
*.key
*.key.meta
*.snk
*.snk.meta
*.cer
*.cer.meta
*.ulf
*.ulf.meta
*.alf
*.alf.meta

# Python runtime, virtual environments and test/tool caches.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Operating-system and editor temporary files.
.DS_Store
._*
.AppleDouble/
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.tmp
*.tmp.meta
